POSTGRES_DB="sua_base"
POSTGRES_USER="seu_usuario"
POSTGRES_PASSWORD="sua_senha"
# Usado pela API para provisionar/conectar aos bancos de controle e de cada tenant.
# No docker-compose isso é sobrescrito para host=db, port=5432; os valores abaixo
# são para rodar a API fora do container, apontando para a porta publicada.
POSTGRES_HOST="localhost"
POSTGRES_PORT="5433"
CONTROL_DB_NAME="rag_control"
# Usado apenas para rodar `alembic upgrade head` manualmente contra um banco específico.
DATABASE_URL="postgresql+psycopg://usuario:senha@localhost:5433/banco"
# Ollama roda nativo no host (fora do Docker) para ter acesso à GPU — o Docker Desktop não repassa
# GPU (principalmente AMD) para containers Linux de forma confiável. A API roda em container e
# acessa o host via host.docker.internal. Baixe os modelos uma vez no host com `ollama pull
# <modelo>`; o docker-compose não baixa modelo nenhum, só informa o nome à API.
# Se preferir Ollama em container (sem GPU, mais lento), troque para http://ollama:11434 e
# reintroduza o serviço "ollama" no docker-compose.yml.
OLLAMA_BASE_URL="http://host.docker.internal:11434"
LLM_MODEL="seu_modelo"
EMBEDDING_MODEL="seu_modelo_de_embedding"
# Opcional: modelo usado só como LLM-judge nas avaliações RAGAS, separado do LLM_MODEL de
# produção acima (evita o viés do modelo se autoavaliar). Se omitido, cai no LLM_MODEL.
RAGAS_JUDGE_MODEL="seu_modelo_judge"
# URL usada pelo navegador para acessar a API (build do frontend via docker-compose).
VITE_API_URL="http://localhost:8000/api/v1"
